# صندوقچی / BoursePilot environment example
# Copy to .env and fill values. Never commit real secrets.

PRODUCT_NAME=صندوقچی

# --- BRS Market Data (production provider) ---
# BRS is the single canonical provider for market data.
# Base URL: https://Api.BrsApi.ir/Tsetmc
# Uncomment and set your key for direct BRS access:
# BRS_API_KEY=your_api_key_here
# BRS_BASE_URL=https://Api.BrsApi.ir/Tsetmc

# --- Optional: Internal Market Gateway ---
# Uncomment ONLY if you have a configured internal gateway:
# MARKET_GATEWAY_URL=http://localhost:8080/api/v1/market
# MARKET_GATEWAY_TOKEN=your_gateway_token

# --- Connection settings ---
BRS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
BRS_TIMEOUT_SECONDS=30
BRS_MAX_RETRIES=2
BRS_ALL_SYMBOLS_TYPE=1

# Provider selection: brs (default), gateway (optional), demo (fallback)
MARKET_DATA_PROVIDER=brs

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Snapshot / ranking ---
SNAPSHOT_DIR=data/snapshots
SCORING_CONFIG_PATH=config/scoring.yaml
FETCH_NAV_IN_DAILY_RANK=false
NAV_FETCH_WORKERS=4

# --- History Engine (SQLite) ---
DATABASE_PATH=data/database.db
HISTORY_CACHE_TTL_SECONDS=300

# --- Telegram report format ---
TELEGRAM_SMART_REPORT=true
TELEGRAM_TOP_N=5
TELEGRAM_WORST_N=5
